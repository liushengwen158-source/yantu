{
  "version": 2,
  "note": "证据规则。dimension 只能是 spec.Dimension 里的取值；negative 表示「明确说自己不会」，同一短句里负向优先。文案改动不需要动代码。",
  "rules": [
    {
      "id": "coding.none",
      "dimension": "coding",
      "level": 1,
      "strength": "strong",
      "polarity": "negative",
      "why": "明确表示没写过代码，属于从零起点。",
      "patterns": [
        "没写过?(代码|程序|代码)",
        "不会(编程|写代码|写程序)",
        "零基础",
        "没学过(编程|写代码)"
      ]
    },
    {
      "id": "coding.syntax",
      "dimension": "coding",
      "level": 1,
      "strength": "strong",
      "polarity": "positive",
      "why": "只接触过语法层面，还不能独立写出程序。",
      "patterns": [
        "只会(一点|一点点|基础语法)",
        "刚学(会)?(python|c\\+\\+|java|语法)",
        "照着(教程|视频)(抄|写)"
      ]
    },
    {
      "id": "coding.loop",
      "dimension": "coding",
      "level": 2,
      "strength": "strong",
      "polarity": "positive",
      "why": "能写循环、函数、类，达到能跟着教程写出来的程度。",
      "patterns": [
        "写过?(循环|函数|类)",
        "会写(循环|函数|类)",
        "写过?(小|简单的)?(脚本|程序)"
      ]
    },
    {
      "id": "coding.debug",
      "dimension": "coding",
      "level": 2,
      "strength": "strong",
      "polarity": "positive",
      "why": "会主动调试而不是卡住，说明能自己排错。",
      "patterns": [
        "会(用)?(print|断点|调试)",
        "调(过)?bug",
        "排查(过)?(报错|错误)"
      ]
    },
    {
      "id": "coding.course-project",
      "dimension": "coding",
      "level": 2,
      "strength": "strong",
      "polarity": "positive",
      "why": "做过课程设计或大作业，写过有规模的代码。",
      "patterns": [
        "写过?(课设|大作业|项目)",
        "做过(课设|小项目|小工具)",
        "做过?(课设|大作业|项目|小工具|小项目)",
        "做过?课程(设计|项目)"
      ]
    },
    {
      "id": "coding.independent",
      "dimension": "coding",
      "level": 3,
      "strength": "strong",
      "polarity": "positive",
      "why": "独立完成过项目，说明能自己拆问题、自己收尾。",
      "patterns": [
        "独立(写|完成|做)(过)?(项目|工具|系统)",
        "自己(从零)?(写|搭)(过)?(一个|了个)"
      ]
    },
    {
      "id": "coding.cpp",
      "dimension": "coding",
      "level": 3,
      "strength": "strong",
      "polarity": "positive",
      "why": "写过 C/C++，说明能处理手动内存与编译流程。",
      "patterns": [
        "写过?c\\+\\+",
        "用(c\\+\\+|cpp)(写|做|开发)",
        "写过?c语言",
        "写过?c(?![a-z0-9+])"
      ]
    },
    {
      "id": "coding.other-lang",
      "dimension": "coding",
      "level": 3,
      "strength": "strong",
      "polarity": "positive",
      "why": "掌握多门语言，迁移成本低。",
      "patterns": [
        "写过?java",
        "写过?rust",
        "写过?go(lang)?",
        "用java(写|做)"
      ]
    },
    {
      "id": "coding.none-lang",
      "dimension": "coding",
      "level": 1,
      "strength": "weak",
      "polarity": "negative",
      "why": "只会背语法题，没写过能跑的功能。",
      "patterns": [
        "只会(背|考试)",
        "代码(都)?是(抄|复制)的"
      ]
    },
    {
      "id": "tools.none",
      "dimension": "tools",
      "level": 1,
      "strength": "strong",
      "polarity": "negative",
      "why": "没用过命令行，后面所有实验操作都会卡住。",
      "patterns": [
        "没用过(命令行|终端|shell)",
        "不会(用)?(命令行|终端|shell|linux)",
        "只会(点)?鼠标"
      ]
    },
    {
      "id": "tools.basic",
      "dimension": "tools",
      "level": 2,
      "strength": "strong",
      "polarity": "positive",
