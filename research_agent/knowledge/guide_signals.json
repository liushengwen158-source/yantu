{
  "version": 1,
  "note": "对话证据规则库。改判定口径只改这里，不动代码。patterns 是正则，按 re.search 在单个句子上匹配。",
  "dimensions": {
    "python": "Python 工程",
    "shell": "命令行 / Linux",
    "math": "数学（线代·概率）",
    "ml": "机器学习",
    "dl": "深度学习与框架",
    "research": "科研流程"
  },
  "rules": [
    {
      "id": "python.script",
      "dimension": "python",
      "level": 2,
      "polarity": "positive",
      "patterns": ["写过.{0,10}(爬虫|脚本|小工具|工具)", "做过.{0,6}(Python|python).{0,4}(项目|作业)"],
      "why": "能独立写出跑得起来的脚本，说明语法、循环、函数这些基本功已经过关"
    },
    {
      "id": "python.class",
      "dimension": "python",
      "level": 3,
      "polarity": "positive",
      "patterns": ["写过.{0,6}(类|class)", "用过.{0,4}面向对象"],
      "why": "用得上类，说明能组织代码结构，而不只是写流水脚本"
    },
    {
      "id": "python.package",
      "dimension": "python",
      "level": 4,
      "polarity": "positive",
      "patterns": ["(自己|独立).{0,4}(写|做|搭)过.{0,6}(包|库|框架)"],
      "why": "能自己封包给别人用，说明工程抽象能力到了可独立的水准"
    },
    {
      "id": "python.debug",
      "dimension": "python",
      "level": 3,
      "polarity": "positive",
      "patterns": ["用过.{0,6}(pdb|断点|debug|调试器)"],
      "why": "会用调试器而不是靠 print 猜，说明排错有方法"
    },
    {
      "id": "python.test",
      "dimension": "python",
      "level": 3,
      "polarity": "positive",
      "patterns": ["写过.{0,6}(单元测试|pytest|unittest)"],
      "why": "写过测试，说明知道怎么验证自己的代码是对的"
    },
    {
      "id": "python.data",
      "dimension": "python",
      "level": 2,
      "polarity": "positive",
      "patterns": ["用(过)?.{0,6}(numpy|pandas|matplotlib)"],
      "why": "用过数据处理库，说明能处理数组和表格，不只是纯语法练习"
    },
    {
      "id": "python.noclass",
      "dimension": "python",
      "level": 1,
      "polarity": "negative",
      "patterns": ["没写过.{0,4}(类|class)", "不(会|太会)写.{0,4}(类|class)"],
      "why": "没写过类，工程组织还停在单文件脚本阶段"
    },
    {
      "id": "python.onlyprint",
      "dimension": "python",
      "level": 1,
      "polarity": "negative",
      "patterns": ["只(会|是).{0,4}print", "只会一点.{0,6}python", "python.{0,4}(零基础|没学过)"],
      "why": "明确说只到入门语法，后面的路线必须从变量和函数重新铺"
    },
    {
      "id": "python.novenv",
      "dimension": "python",
      "level": 1,
      "polarity": "negative",
      "patterns": ["没(用|建|弄)?过.{0,4}(虚拟环境|venv|virtualenv)"],
      "why": "没用过虚拟环境，装包冲突会反复踩，环境这块要先补"
    },

    {
      "id": "shell.linux",
      "dimension": "shell",
      "level": 2,
      "polarity": "positive",
      "patterns": ["用(过)?.{0,4}(Linux|Ubuntu|CentOS|Debian|服务器|WSL)", "在.{0,4}(Linux|服务器).{0,4}(上|里)"],
      "why": "在 Linux 上动过手，路径、权限、包管理这些概念有了"
    },
    {
      "id": "shell.onlybasic",
      "dimension": "shell",
      "level": 1,
      "polarity": "negative",
      "patterns": ["只(会|能用).{0,8}(cd|ls|mkdir)", "只会.{0,4}(基本|简单).{0,4}命令"],
      "why": "只到 cd/ls 水平，跑实验要用的管道、重定向、后台任务还不会"
    },
    {
      "id": "shell.none",
      "dimension": "shell",
      "level": 1,
      "polarity": "negative",
      "patterns": ["没(用|碰|接|学)?过.{0,4}(命令行|终端|shell|Linux)"],
      "why": "没用过命令行，第一步得先过终端这道门"
    },
    {
      "id": "shell.path",
      "dimension": "shell",
      "level": 3,
      "polarity": "positive",
      "patterns": ["配(过|置过).{0,6}(环境变量|PATH)"],
      "why": "手动配过 PATH，说明理解进程怎么找到可执行文件，排错会快很多"
    },
    {
      "id": "shell.script",
      "dimension": "shell",
      "level": 3,
      "polarity": "positive",
      "patterns": ["写过.{0,6}(bash|shell|sh).{0,4}脚本"],
      "why": "写过 shell 脚本，能把重复操作自动化"
    },
    {
      "id": "shell.ssh",
      "dimension": "shell",
      "level": 2,
      "polarity": "positive",
      "patterns": ["(用过|配置过).{0,4}ssh", "ssh.{0,6}(登录|连上|连接)"],
      "why": "连过远程机器，说明接触过真实服务器环境"
    },
    {
      "id": "shell.vim",
      "dimension": "shell",
      "level": 2,
      "polarity": "positive",
      "patterns": ["用.{0,2}(vim|nano|emacs)"],
      "why": "在终端里编辑过文件，至少不会因为没图形界面就卡住"
    },

    {
      "id": "math.course",
      "dimension": "math",
      "level": 2,
      "polarity": "positive",
      "patterns": ["学过.{0,6}(线性代数|线代|概率论|概率统计|微积分|高数|数学分析)", "(线性代数|线代|概率论|概率统计|微积分|高数|数学分析).{0,6}(学过|上过|课)"],
      "why": "上过课，概念和记号有了，缺的通常是把公式和代码对上"
    },
    {
      "id": "math.derivation",
      "dimension": "math",
      "level": 3,
      "polarity": "positive",
      "patterns": ["推(过|导过|过).{0,8}(公式|梯度|反向传播|导数)", "能推.{0,6}(公式|梯度)"],
      "why": "能手推梯度，反向传播那套就不会只当成黑箱"
    },
    {
      "id": "math.nodeviation",
      "dimension": "math",
      "level": 1,
      "polarity": "negative",
      "patterns": ["不(会|太会|太能).{0,6}(推导|证明)", "推不(出|来)", "推.{0,2}公式.{0,4}(吃力|费劲|不会|不行)"],
      "why": "不会推导，公式只能当结论记，遇到改结构就会脱节"
    },
    {
      "id": "math.weak",
      "dimension": "math",
      "level": 1,
      "polarity": "negative",
      "patterns": ["(数学|高数|线代|线性代数|概率).{0,6}(不好|很差|吃力|头疼|忘了|忘光)"],
      "why": "自评数学吃力，这块要放在路线前段，否则后面读论文会一直卡符号"
    },

    {
      "id": "ml.course",
      "dimension": "ml",
      "level": 2,
      "polarity": "positive",
      "patterns": ["上过.{0,6}(机器学习|模式识别|数据挖掘)", "(机器学习|模式识别|数据挖掘).{0,6}(上过|学过|这门课|课)"],
      "why": "系统上过课，监督/无监督这套框架是完整的"
    },
    {
      "id": "ml.sklearn",
      "dimension": "ml",
      "level": 2,
      "polarity": "positive",
      "patterns": ["用(过)?.{0,6}(sklearn|scikit-learn)"],
      "why": "调过 sklearn，至少走过 fit/predict/评估这条链"
    },
    {
      "id": "ml.concept",
      "dimension": "ml",
      "level": 2,
      "polarity": "positive",
      "patterns": ["知道.{0,6}(过拟合|交叉验证|正则化|训练集|验证集)"],
      "why": "知道过拟合和验证集，说明理解泛化这件事，不只是会调 API"
    },
    {
      "id": "ml.noconcept",
      "dimension": "ml",
      "level": 1,
      "polarity": "negative",
      "patterns": ["不(知道|懂|清楚).{0,6}(过拟合|交叉验证|正则化)"],
      "why": "不清楚过拟合，模型好坏就没法判断，容易把跑通当成做对"
    },
    {
      "id": "ml.tuning",
      "dimension": "ml",
      "level": 3,
      "polarity": "positive",
      "patterns": ["调(过|参过).{0,6}(超参|参数|learning rate|学习率)"],
      "why": "调过超参，说明经历过「效果不好 → 改哪里 → 再看」的完整循环"
    },
    {
      "id": "ml.none",
      "dimension": "ml",
      "level": 1,
      "polarity": "negative",
      "patterns": ["没(学过|接触过|上过|了解过).{0,6}(机器学习|ML)"],
      "why": "没接触过机器学习，路线要从「什么是训练」开始"
    },

    {
      "id": "dl.install",
      "dimension": "dl",
      "level": 2,
      "polarity": "positive",
      "patterns": ["装(过|了).{0,6}(torch|pytorch|tensorflow|tf)", "pip install.{0,20}(torch|tensorflow)"],
      "why": "自己装过框架，知道装和跑是两件不同的事"
    },
    {
      "id": "dl.cudafail",
      "dimension": "dl",
      "level": 2,
      "polarity": "positive",
      "patterns": ["(cuda|CUDA).{0,10}(false|不可用|失败|没成功)", "(torch|pytorch).{0,10}cuda.{0,6}(false|不可用)"],
      "why": "踩过 CUDA 不可用这个坑，GPU 环境的真实难点已经碰到了"
    },
    {
      "id": "dl.train",
      "dimension": "dl",
      "level": 3,
      "polarity": "positive",
      "patterns": ["跑过.{0,8}(训练|模型|实验|demo)", "训练跑(通|起来)过"],
      "why": "完整跑过训练，数据加载、前向、反向、评估这条链走通过一次"
    },
    {
      "id": "dl.ownmodel",
      "dimension": "dl",
      "level": 3,
      "polarity": "positive",
      "patterns": ["训(练)?过.{0,8}(自己的|一个).{0,4}(模型|网络)"],
      "why": "训练过自己的模型，说明能改动代码而不只是执行别人的命令"
    },
    {
      "id": "dl.modify",
      "dimension": "dl",
      "level": 4,
      "polarity": "positive",
      "patterns": ["改过.{0,8}(网络|模型).{0,6}(结构|层|loss|损失)"],
      "why": "改过网络结构或损失函数，已经进入「设计」而不只是「复现」"
    },
    {
      "id": "dl.transformer",
      "dimension": "dl",
      "level": 4,
      "polarity": "positive",
      "patterns": ["实现过.{0,8}(transformer|attention|注意力)"],
      "why": "手写过 attention，对当前主流模型的内部不再陌生"
    },
    {
      "id": "dl.none",
      "dimension": "dl",
      "level": 1,
      "polarity": "negative",
      "patterns": ["没(碰过|用过|学过|接触过|跑过).{0,8}(深度学习|神经网络|torch|pytorch|tensorflow)", "(深度学习|神经网络|torch|pytorch|tensorflow).{0,6}(没碰过|没学过|没用过|没跑过)"],
      "why": "没碰过深度学习，路线前段要先把「模型在学什么」讲清楚"
    },

    {
      "id": "research.read",
      "dimension": "research",
      "level": 2,
      "polarity": "positive",
      "patterns": ["读过.{0,8}论文", "论文.{0,6}读过", "读过.{0,4}篇"],
      "why": "读过论文，至少知道一篇论文的骨架长什么样"
    },
    {
      "id": "research.readmany",
      "dimension": "research",
      "level": 3,
      "polarity": "positive",
      "patterns": ["读过.{0,4}([3-9]|[1-9][0-9])\\s*篇"],
      "why": "读过三篇以上，说明不是在「读第一篇」的阶段"
    },
    {
      "id": "research.repro",
      "dimension": "research",
      "level": 3,
      "polarity": "positive",
      "patterns": ["复现过.{0,10}(论文|模型|实验|结果)"],
      "why": "复现过别人的工作，走完了从读代码到对上数字的完整流程"
    },
    {
      "id": "research.log",
      "dimension": "research",
      "level": 3,
      "polarity": "positive",
      "patterns": ["(做|写)过.{0,6}(实验记录|实验日志|实验笔记)"],
      "why": "记过实验日志，知道结果要可追溯，这是科研习惯的分水岭"
    },
    {
      "id": "research.write",
      "dimension": "research",
      "level": 4,
      "polarity": "positive",
      "patterns": ["写过.{0,8}(综述|开题|技术报告|paper)"],
      "why": "写过成篇的东西，表达和结构能力已经练过"
    },
    {
      "id": "research.noread",
      "dimension": "research",
      "level": 1,
      "polarity": "negative",
      "patterns": ["(没|还没)读过.{0,6}论文", "一篇论文.{0,4}(都)?没读"],
      "why": "没读过论文，第一篇要有人带着拆结构，直接让他自己读会卡住"
    },
    {
      "id": "research.nomethod",
      "dimension": "research",
      "level": 1,
      "polarity": "negative",
      "patterns": ["不(知道|会).{0,8}(怎么|如何).{0,2}读", "不(会|知道).{0,6}读.{0,2}(论文|paper)"],
      "why": "不知道读法，容易从头读到尾再放弃，需要先教三遍法"
    }
  ]
}
