      "patterns": [
        "会(用)?(cd|ls|基础命令)",
        "用过?(命令行|终端)",
        "会(用)?linux"
      ]
    },
    {
      "id": "tools.pipe",
      "dimension": "tools",
      "level": 2,
      "strength": "strong",
      "polarity": "positive",
      "why": "会用管道与文本处理，能自己从日志里找信息。",
      "patterns": [
        "用(过)?(管道|grep|awk|sed)",
        "会用?\\|"
      ]
    },
    {
      "id": "tools.script",
      "dimension": "tools",
      "level": 2,
      "strength": "strong",
      "polarity": "positive",
      "why": "写过脚本，能把重复操作自动化。",
      "patterns": [
        "写过?(shell|bash)(脚本)?",
        "写过?脚本"
      ]
    },
    {
      "id": "tools.ssh",
      "dimension": "tools",
      "level": 3,
      "strength": "strong",
      "polarity": "positive",
      "why": "连过远程机器，能在服务器上跑实验。",
      "patterns": [
        "用(过)?ssh",
        "远程(登录|连|跑)",
        "连(过)?服务器"
      ]
    },
    {
      "id": "tools.git",
      "dimension": "tools",
      "level": 3,
      "strength": "strong",
      "polarity": "positive",
      "why": "用过版本控制，能管代码与回溯改动。",
      "patterns": [
        "用(过)?git",
        "git(提交|push|pull|clone)",
        "用(过)?github",
        "用(过)?[^，。]{0,6}(git|github)"
      ]
    },
    {
      "id": "tools.env",
      "dimension": "tools",
      "level": 3,
      "strength": "strong",
      "polarity": "positive",
      "why": "配过环境或虚拟环境，能处理依赖冲突。",
      "patterns": [
        "配(过)?(环境变量|虚拟环境|conda|venv)",
        "装(过)?(cuda|驱动|torch)"
      ]
    },
    {
      "id": "tools.container",
      "dimension": "tools",
      "level": 3,
      "strength": "strong",
      "polarity": "positive",
      "why": "用过容器，能复现别人的运行环境。",
      "patterns": [
        "用(过)?(docker|容器)",
        "写过?dockerfile"
      ]
    },
    {
      "id": "tools.none-linux",
      "dimension": "tools",
      "level": 1,
      "strength": "weak",
      "polarity": "negative",
      "why": "不熟 Linux，而多数论文代码只在 Linux 上跑得通。",
      "patterns": [
        "不(太)?会(用)?(linux|命令行)",
        "只在?windows(上)?(跑|用)"
      ]
    },
    {
      "id": "math.none",
      "dimension": "math",
      "level": 1,
      "strength": "strong",
      "polarity": "negative",
